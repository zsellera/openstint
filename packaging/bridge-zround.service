[Unit]
Description=OpenStint ZRound Bridge
After=openstint.service
Requires=openstint.service

[Service]
Type=simple
; Same reasoning as openstint.service. The bridge keeps no state and talks to
; the decoder over TCP, so it needs no shared UID with it.
DynamicUser=yes
WorkingDirectory=/usr/share/openstint/integrations
ExecStart=/usr/bin/python3 /usr/share/openstint/integrations/bridge-zround.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
