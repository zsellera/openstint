[Unit]
Description=OpenStint ZRound Bridge
After=openstint.service
Requires=openstint.service

[Service]
Type=simple
; Created by the package postinstall script.
User=openstint
WorkingDirectory=/usr/share/openstint/integrations
ExecStart=/usr/bin/python3 /usr/share/openstint/integrations/bridge-zround.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
